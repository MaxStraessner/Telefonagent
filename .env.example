# Anwendung
APP_ENV=development
APP_COMPONENT=runtime
APP_NAME=Telefonagent
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
APP_BASE_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
LOG_LEVEL=INFO

# Lokale PostgreSQL-Entwicklung – vor produktiver Nutzung zwingend ersetzen
POSTGRES_DB=telefonagent
POSTGRES_USER=telefonagent
POSTGRES_PASSWORD=telefonagent_local
DATABASE_URL=postgresql+psycopg://telefonagent:telefonagent_local@localhost:5432/telefonagent
# Produktion: privilegierte Migrationsrolle getrennt von der RLS-gebundenen Runtime-Rolle
MIGRATION_DATABASE_URL=

# Mailzustellung für Einladungen und Passwort-Recovery (in Produktion Pflicht)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_STARTTLS=true

# Authentifizierung und serverseitige Sitzungen
# In Produktion mindestens 32 zufällige Bytes; z. B. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
AUTH_HMAC_SECRET=development-only-change-this-auth-secret
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
SESSION_TOUCH_INTERVAL_SECONDS=300
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_USERNAME_FAILURE_LIMIT=5
AUTH_IP_FAILURE_LIMIT=30

# Seed ist ausschließlich ein expliziter Entwicklungshelfer. Kein Standardpasswort setzen.
DEV_BOOTSTRAP_ENABLED=false
DEV_BOOTSTRAP_USERNAME=owner@telefonagent.local
DEV_BOOTSTRAP_PASSWORD=
INITIAL_SETUP_TOKEN=
ALLOW_DEVELOPMENT_TENANT_FALLBACK=false
DEVELOPMENT_TENANT_SLUG=salon-haarkunst-test

# Nur serverseitig; niemals mit VITE_ prefixen oder an den Browser ausliefern
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_MAX_SESSION_MINUTES=10
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=1024
OPENAI_REALTIME_TRANSCRIPTION_ENABLED=true
OPENAI_REALTIME_LOG_RAW_EVENTS=false
# Installationsspezifisch ersetzen; dient nur zur pseudonymen Safety-ID-Bildung
OPENAI_SAFETY_IDENTIFIER_SALT=telefonagent-local-installation

# Kalender-OAuth und Tokenverschlüsselung – Fernet-Schlüssel einmalig erzeugen mit:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_TOKEN_ENCRYPTION_KEY=

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth/google/callback

MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth/microsoft/callback
MICROSOFT_CALENDAR_TENANT=common

# Sitzungssnapshot und gezielte Providerabfragen
AVAILABILITY_SNAPSHOT_HORIZON_DAYS=14
AVAILABILITY_SNAPSHOT_TTL_SECONDS=120
CALENDAR_PROVIDER_TIMEOUT_SECONDS=8
